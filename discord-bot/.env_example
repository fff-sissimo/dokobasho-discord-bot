# Discord Bot Settings
# Developer Portal (https://discord.com/developers/applications) で取得した情報を設定
# BOT_TOKEN を推奨。旧名称の DISCORD_BOT_TOKEN でも可
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=

# Google Sheets API Settings
# Google Cloud Consoleで取得した情報を設定
# サービスアカウントキーのJSONファイルパス（推奨）
GOOGLE_SA_KEY_PATH=
# もしくは、サービスアカウントキーのJSONをBase64エンコードした文字列
GOOGLE_SA_KEY_JSON=
# データの保存先となるGoogleスプレッドシートのID
SHEET_ID=

# (任意) シートの最大行数上限。超過時は処理を停止し、移行を促す
REMINDER_MAX_ROWS=5000
# (任意) sending 状態のリマインダーを再取得するまでの待機時間(ミリ秒)
REMINDER_SENDING_TIMEOUT_MS=300000

# その他
# n8n の内部 Webhook URL（テスト/本番で切り替え）
N8N_WEBHOOK_URL=
# (任意) n8n Webhook Guard の共有シークレット（推奨: 32文字以上）
N8N_WEBHOOK_SECRET=

# /fairy response controls
# 1/true で /fairy・メンション・Bot返信の応答を有効化。OpenClaw撤退後の既定は停止。
FAIRY_ENABLED=false
# slow-path 連携先の n8n ベース URL（例: https://n8n.example.com）
N8N_BASE=
# slow-path Webhook path（未指定時: /webhook/fairy-slow-path）
N8N_SLOW_PATH_WEBHOOK_PATH=/webhook/fairy-slow-path
# slow-path Webhook timeout ms（未指定時: 8000）
N8N_SLOW_PATH_TIMEOUT_MS=8000
# (任意) 一次回答を AI 生成するための OpenAI API key
OPENAI_API_KEY=
# (任意) 一次回答用モデル（未指定時: o4-mini）
FIRST_REPLY_AI_MODEL=o4-mini
# (任意) 一次回答生成タイムアウト ms（未指定時: 5000）
FIRST_REPLY_AI_TIMEOUT_MS=5000
# (任意) OpenAI API base URL（未指定時: https://api.openai.com）
OPENAI_BASE_URL=https://api.openai.com
# (任意) 1/true でメンション・Bot返信を /fairy と同等に処理（既定: true）
FAIRY_ENABLE_MESSAGE_TRIGGER=true
# Discord Developer PortalでMessage Content Intentを無効化する場合はfalse
DISCORD_MESSAGE_CONTENT_INTENT_ENABLED=true

# 恒久記憶 Sync（n8n -> discord-bot 内部HTTP -> Markdown）
# 1/true で有効化
PERMANENT_MEMORY_SYNC_ENABLED=true
# 受信ホスト・ポート（docker network 内で利用）
PERMANENT_MEMORY_SYNC_HOST=0.0.0.0
PERMANENT_MEMORY_SYNC_PORT=8789
# 受信パス
PERMANENT_MEMORY_SYNC_PATH=/internal/permanent-memory/sync
# 取得パス（親AI などが恒久記憶を読む内部 API）
PERMANENT_MEMORY_READ_PATH=/internal/permanent-memory/read
# (推奨) 共有トークン。n8n HTTP Request 側で x-permanent-sync-token に設定する
PERMANENT_MEMORY_SYNC_TOKEN=
# Markdown 保存先ディレクトリ（コンテナ内）
PERMANENT_MEMORY_SYNC_DIR=/opt/dokobasho/permanent-memory
# Markdown ファイル名
PERMANENT_MEMORY_SYNC_FILE=permanent-memory.md
# 取得 API で返す最大文字数
PERMANENT_MEMORY_READ_MAX_CHARS=8000

# Hermes -> reminder 内部API bridge
# discord-resource-service の待受設定。Docker内部ネットワークでのみ利用する。
RESOURCE_API_HOST=0.0.0.0
RESOURCE_API_PORT=8790
RESOURCE_API_PATH_PREFIX=/internal/remind
# (推奨) Hermes plugin から x-resource-api-token で送信する共有トークン
RESOURCE_API_TOKEN=
# tokenなしloopback起動をローカル開発で明示許可する場合だけtrue
INTERNAL_API_ALLOW_INSECURE_LOOPBACK=false

# Scheduler Discord delivery mode
# gateway: discord.js Gateway login / rest: Bot token REST API without Gateway login
SCHEDULER_DISCORD_DELIVERY_MODE=gateway
DISCORD_API_BASE_URL=https://discord.com/api/v10

# Dokobasho image generation (Hermes -> n8n image webhook)
# default false。初回E2Eで有効化する場合だけ true にする
DOKOBASHO_IMAGE_ENABLED=false
# 初回E2Eでは DOKOBASHO_IMAGE_ENABLED=true + テスト用チャンネルID指定が必須
DOKOBASHO_IMAGE_WEBHOOK_URL=https://n8n.example.com/webhook/dokobasho-image-generation
# n8n Webhook の Bearer token。秘密値なのでログやREADMEへ直書きしない
DOKOBASHO_IMAGE_WEBHOOK_TOKEN=
DOKOBASHO_IMAGE_ALLOWED_CHANNEL_IDS=
# 全チャンネル許可は初期状態では無効。全公開時だけ明示 true にする
DOKOBASHO_IMAGE_ALLOW_ALL_CHANNELS=false
# 緊急停止/段階公開用。カンマ区切り
DOKOBASHO_IMAGE_DISABLED_GUILD_IDS=
DOKOBASHO_IMAGE_DISABLED_USER_IDS=
DOKOBASHO_IMAGE_TIMEOUT_MS=130000
DOKOBASHO_IMAGE_INTENT_CONFIDENCE_THRESHOLD=0.80
DOKOBASHO_IMAGE_CONFIRMATION_TTL_SECONDS=180
# OpenAI intent detector は OPENAI_API_KEY がある場合だけ利用。未設定時はdeterministic fallback
DOKOBASHO_IMAGE_INTENT_MODEL=gpt-4.1-mini
DOKOBASHO_IMAGE_INTENT_TIMEOUT_MS=5000

# Dokobasho image generation phase 2 controls
DOKOBASHO_IMAGE_USER_LIMIT_PER_HOUR=5
DOKOBASHO_IMAGE_GUILD_LIMIT_PER_DAY=100
DOKOBASHO_IMAGE_GUILD_CONCURRENCY=2
DOKOBASHO_IMAGE_GUILD_QUEUE_SIZE=5
DOKOBASHO_IMAGE_QUEUE_TTL_SECONDS=900

# VC Memo
# 1/true で /vc-memo を有効化
VC_MEMO_ENABLED=false
# (任意) VC Memo 専用 OpenAI API key。未指定時は OPENAI_API_KEY を利用
VC_MEMO_OPENAI_API_KEY=
# (任意) OpenAI API base URL。未指定時: https://api.openai.com/v1
VC_MEMO_OPENAI_BASE_URL=https://api.openai.com/v1
# (任意) STT の入力音声言語。日本語固定なら ja
VC_MEMO_STT_LANGUAGE=ja
# (任意) STTへ送る1チャンクあたりの最大WAVサイズ。OpenAIの上限より余裕を持たせる
VC_MEMO_STT_MAX_WAV_BYTES=20971520
# (任意) 1セッションあたりのPCM保存上限bytes。超過時は録音追記を停止
VC_MEMO_MAX_SESSION_BYTES=104857600
# STT timeout/retry
VC_MEMO_STT_TIMEOUT_MS=60000
VC_MEMO_STT_RETRIES=3
# (任意) 要約モデル
VC_MEMO_SUMMARY_MODEL=gpt-4o-mini
# 要約timeoutと1リクエストの文字起こし最大文字数
VC_MEMO_SUMMARY_TIMEOUT_MS=60000
VC_MEMO_SUMMARY_MAX_CHUNK_CHARS=24000
# 音声・全文文字起こし・ドラフトの永続保存先
VC_MEMO_CACHE_DIR=/opt/dokobasho/vc-memo
# VC_MEMO_ENABLED=true の場合は必須。許可 guild/channel をカンマ区切りで指定
VC_MEMO_ALLOWED_GUILD_IDS=
VC_MEMO_ALLOWED_CHANNEL_IDS=
